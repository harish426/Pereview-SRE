# Copy to .env (never commit .env)

# Full ARM resource ID of the Application Insights component
AZSRE_APPINSIGHTS_RESOURCE_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/microsoft.insights/components/<app-insights-name>

# Azure OpenAI
AZSRE_AOAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZSRE_AOAI_DEPLOYMENT=<your-chat-deployment-name>
AZSRE_AOAI_API_VERSION=2024-10-21
# Leave empty to use keyless Entra ID auth (recommended). Otherwise set a key.
AZSRE_AOAI_API_KEY=

# Limits / guardrails
AZSRE_MAX_ROWS=200
AZSRE_QUERY_TIMEOUT_S=60
AZSRE_MAX_AGENT_STEPS=8
AZSRE_DEFAULT_LOOKBACK_HOURS=24

# Logging (file is written to <AZSRE_LOG_DIR>/azsre.log, rotated, secrets redacted)
AZSRE_LOG_LEVEL=INFO
AZSRE_LOG_DIR=logs

# Web server (binds to localhost only by default)
AZSRE_WEB_HOST=127.0.0.1
AZSRE_WEB_PORT=8080
# Optional bearer token required by the web API if set
AZSRE_WEB_TOKEN=
