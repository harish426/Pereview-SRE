# Copy to .env (never commit .env)

# Full ARM resource ID of the Application Insights component
PEREVIEWSRE_APPINSIGHTS_RESOURCE_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/microsoft.insights/components/<app-insights-name>

# Azure OpenAI
PEREVIEWSRE_AOAI_ENDPOINT=https://<your-resource>.openai.azure.com/
PEREVIEWSRE_AOAI_DEPLOYMENT=<your-chat-deployment-name>
PEREVIEWSRE_AOAI_API_VERSION=2024-10-21
# Leave empty to use keyless Entra ID auth (recommended). Otherwise set a key.
PEREVIEWSRE_AOAI_API_KEY=

# Limits / guardrails
PEREVIEWSRE_MAX_ROWS=200
PEREVIEWSRE_QUERY_TIMEOUT_S=60
PEREVIEWSRE_MAX_AGENT_STEPS=8
PEREVIEWSRE_DEFAULT_LOOKBACK_HOURS=24

# Logging (file is written to <PEREVIEWSRE_LOG_DIR>/pereviewsre.log, rotated, secrets redacted)
PEREVIEWSRE_LOG_LEVEL=INFO
PEREVIEWSRE_LOG_DIR=logs

# Web server (binds to localhost only by default)
PEREVIEWSRE_WEB_HOST=127.0.0.1
PEREVIEWSRE_WEB_PORT=8080
# Optional bearer token required by the web API if set
PEREVIEWSRE_WEB_TOKEN=
