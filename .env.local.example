# Local development. Copy to .env.local (never commit).
# Used when PEREVIEWSRE_ENV=local (the default outside Azure).
# Note: under `func start`, values in local.settings.json override this file.
PEREVIEWSRE_ENV=local

PEREVIEWSRE_APPINSIGHTS_RESOURCE_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/microsoft.insights/components/<dev-app-insights-name>

PEREVIEWSRE_AOAI_ENDPOINT=https://<your-resource>.openai.azure.com/
PEREVIEWSRE_AOAI_DEPLOYMENT=<your-chat-deployment-name>
PEREVIEWSRE_AOAI_API_VERSION=2024-10-21
# Empty = keyless Entra ID auth via `az login` (recommended)
PEREVIEWSRE_AOAI_API_KEY=

PEREVIEWSRE_MAX_ROWS=200
PEREVIEWSRE_QUERY_TIMEOUT_S=60
PEREVIEWSRE_MAX_AGENT_STEPS=8
PEREVIEWSRE_DEFAULT_LOOKBACK_HOURS=24

PEREVIEWSRE_LOG_LEVEL=DEBUG
PEREVIEWSRE_LOG_DIR=logs

# Token optional locally
PEREVIEWSRE_WEB_TOKEN=
