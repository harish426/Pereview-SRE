# Production. In Azure, set these as Function App application settings (not a file):
#   az functionapp config appsettings set -n <app> -g <rg> --settings @settings.json
# This file is only for running production mode on a non-Azure host.
PEREVIEWSRE_ENV=production

PEREVIEWSRE_APPINSIGHTS_RESOURCE_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/microsoft.insights/components/<prod-app-insights-name>

PEREVIEWSRE_AOAI_ENDPOINT=https://<your-resource>.openai.azure.com/
PEREVIEWSRE_AOAI_DEPLOYMENT=<your-chat-deployment-name>
PEREVIEWSRE_AOAI_API_VERSION=2024-10-21
# Keep empty: use the Function App's managed identity (grant it the roles below)
PEREVIEWSRE_AOAI_API_KEY=

PEREVIEWSRE_MAX_ROWS=200
PEREVIEWSRE_QUERY_TIMEOUT_S=60
PEREVIEWSRE_MAX_AGENT_STEPS=8
PEREVIEWSRE_DEFAULT_LOOKBACK_HOURS=24

PEREVIEWSRE_LOG_LEVEL=INFO

# REQUIRED in production (app refuses to start/serve without it). Use a Key Vault reference.
PEREVIEWSRE_WEB_TOKEN=
